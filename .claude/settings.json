{
  "permissions": {
    "ask": [
      "Bash(devtrim * --apply*)",
      "Bash(*/target/*/devtrim * --apply*)",
      "Bash(cargo run* --apply*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'bash scripts/verify.sh offline'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
